{
  "expo": {
    "name": "PocketGym: AI Fitness Tracker",
    "slug": "yourpocketgym",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymios",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rohith.com.yourpocketgym",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PocketGym uses the camera to scan food for calorie and macro estimation, and to take progress photos.",
        "NSPhotoLibraryUsageDescription": "PocketGym accesses your photos to analyze food, save progress photos, and set your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "PocketGym saves progress photos and food-scan captures to your photo library when you choose to.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rohith.com.yourpocketgym",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.387235327844-liqf9v0o9o6hid6195l0t9qq00png4jc"
        }
      ],
      "expo-image-picker",
      "expo-secure-store",
      "expo-web-browser",
      "react-native-bottom-tabs",
      [
        "expo-audio",
        {
          "microphonePermission": "PocketGym uses the microphone so Pro members can log workouts by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c37b7044-ad80-4225-9481-075b967588c8"
      }
    },
    "owner": "rohith.com"
  }
}
